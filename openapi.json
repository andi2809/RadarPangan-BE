{
  "openapi": "3.1.0",
  "info": {
    "title": "Radar Pangan API — Early Warning & Decision Support System",
    "description": "API MVP Radar Pangan — GIS early warning + decision support harga pangan Jawa Barat (27 kab/kota, 5 komoditas poko).\n\nMendukung integrasi 100% dengan Front End Dashboard MapLibre dan Landing Page.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/publik/ringkasan-landing": {
      "get": {
        "tags": [
          "Publik"
        ],
        "summary": "Get Ringkasan Landing",
        "description": "Ringkasan landing dari snapshot PIHPS nyata (bukan angka demo).\n\nBentuk respons dipertahankan agar kompatibel dengan front end; angka yang belum\npunya sumber (mis. laporan warga) dikembalikan 0 dan ditandai di meta.",
        "operationId": "get_ringkasan_landing_api_v1_publik_ringkasan_landing_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeResponse_RingkasanLandingData_"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/komoditas": {
      "get": {
        "tags": [
          "Komoditas"
        ],
        "summary": "Get All Commodities",
        "description": "Mengambil daftar 5 komoditas pangan pokok strategis beserta harga acuan resmi (HAP/HET).",
        "operationId": "get_all_commodities_api_v1_komoditas_get",

          {
            "name": "lat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Latitude GPS pelapor",
              "default": -6.9175,
              "title": "Lat"
            },
            "description": "Latitude GPS pelapor"
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Longitude GPS pelapor",
              "default": 107.6191,
              "title": "Lng"
            },
            "description": "Longitude GPS pelapor"
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Radius klaster konsensus",
              "default": 3.0,
              "title": "Radius Km"
            },
            "description": "Radius klaster konsensus"
          }

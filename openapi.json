    "/api/v1/wilayah/{kode}/ringkasan": {
      "get": {
        "tags": [
          "Wilayah"
        ],
        "summary": "Get Wilayah Ringkasan",
        "description": "Mengambil ringkasan telemetri satu wilayah: harga aktual, HET/HAP, H+7, EWS score, tren, dan daya beli UMK.",
        "operationId": "get_wilayah_ringkasan_api_v1_wilayah__kode__ringkasan_get",
        "parameters": [
          {
            "name": "kode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Kode"
            }
          },
          {
            "name": "komoditas",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "ID komoditas",
              "default": "beras_medium",
              "title": "Komoditas"
            },
            "description": "ID komoditas"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {

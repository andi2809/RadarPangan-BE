              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/peta/status": {
      "get": {
        "tags": [
          "Peta"
        ],
        "summary": "Get Peta Status",
        "description": "Status harga + skor EWS untuk 27 kab/kota Jawa Barat.\n\nHarga diambil dari snapshot PIHPS (`data/raw/pihps_jabar_*.csv`).\nWilayah tanpa data dikembalikan `status=\"tidak_ada_data\"` — tidak dikarang.",
        "operationId": "get_peta_status_api_v1_peta_status_get",
        "parameters": [
          {
            "name": "komoditas",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "ID komoditas kanonik",
              "default": "beras_medium",
              "title": "Komoditas"
            },
            "description": "ID komoditas kanonik"
          },
          {
            "name": "tanggal",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tanggal observasi YYYY-MM-DD",
              "title": "Tanggal"
            },
            "description": "Tanggal observasi YYYY-MM-DD"
          },
          {
            "name": "layer",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "aktual",
                "h7"
              ],
              "type": "string",
              "description": "Lapisan visualisasi data (aktual | h7)",
              "default": "aktual",
              "title": "Layer"
            },
            "description": "Lapisan visualisasi data (aktual | h7)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeResponse_List_StatusPetaItem__"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/laporan-warga/sekitar": {
      "get": {
        "tags": [
          "Laporan Warga"
        ],
        "summary": "Get Laporan Sekitar",
